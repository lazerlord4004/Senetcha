local espButton = createButton("ESP: OFF", 235)

local function removeESP(plr)
	local data = espObjects[plr]

	if not data then
		return
	end

	if data.box then
		data.box:Destroy()
	end

	if data.billboard then
		data.billboard:Destroy()
	end

	if data.connection then
		data.connection:Disconnect()
	end

	espObjects[plr] = nil
end

local function clearESP()
	for plr in pairs(espObjects) do
		removeESP(plr)
	end
end

local function createBoxESP(plr)
	if plr == player then
		return
	end

	if not espEnabled then
		return
	end

	local char = plr.Character

	if not char then
		return
	end

	local targetRoot = char:FindFirstChild("HumanoidRootPart")
	local targetHumanoid = char:FindFirstChildOfClass("Humanoid")

	if not targetRoot or not targetHumanoid then
		return
	end

	removeESP(plr)

	------------------------------------------------
	-- ACTUAL BOX
	------------------------------------------------

	local box = Instance.new("BoxHandleAdornment")

	box.Name = "SenetchaBox"
	box.Adornee = targetRoot

	-- Constant physical size
	box.Size = Vector3.new(4, 6, 2)

	box.CFrame = CFrame.new(0, 0, 0)

	box.Color3 = Color3.fromRGB(255, 0, 220)

	box.Transparency = 0.35
	box.AlwaysOnTop = true
	box.ZIndex = 10

	box.Parent = targetRoot

	------------------------------------------------
	-- NAME / HP / DISTANCE
	------------------------------------------------

	local billboard = Instance.new("BillboardGui")

	billboard.Name = "SenetchaESPInfo"
	billboard.Adornee = targetRoot
	billboard.Size = UDim2.new(0, 180, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true

	billboard.Parent = targetRoot

	local info = Instance.new("TextLabel")

	info.Size = UDim2.new(1, 0, 1, 0)
	info.BackgroundTransparency = 1

	info.TextColor3 = Color3.fromRGB(255, 255, 255)
	info.TextStrokeTransparency = 0

	info.Font = Enum.Font.GothamBold
	info.TextSize = 12

	info.Parent = billboard

	------------------------------------------------
	-- UPDATE ESP
	------------------------------------------------

	local connection

	connection = RunService.RenderStepped:Connect(function()
		if not espEnabled then
			removeESP(plr)
			return
		end

		if not plr.Parent then
			removeESP(plr)
			return
		end

		if not char.Parent then
			removeESP(plr)
			return
		end

		if not targetRoot.Parent or not targetHumanoid.Parent then
			removeESP(plr)
			return
		end

		local myRoot = rootPart

		local distance = 0

		if myRoot and myRoot.Parent then
			distance = math.floor(
				(targetRoot.Position - myRoot.Position).Magnitude
			)
		end

		info.Text =
			plr.DisplayName ..
			"\nHP: " ..
			math.floor(targetHumanoid.Health) ..
			" | " ..
			distance ..
			" studs"
	end)

	espObjects[plr] = {
		box = box,
		billboard = billboard,
		connection = connection
	}
end

