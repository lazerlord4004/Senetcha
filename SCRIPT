local slider = Instance.new("Frame")
slider.Size = UDim2.new(1, -30, 0, 10)
slider.Position = UDim2.new(0, 15, 0, 160)
slider.BackgroundColor3 = Color3.fromRGB(55, 55, 60)
slider.BorderSizePixel = 0
